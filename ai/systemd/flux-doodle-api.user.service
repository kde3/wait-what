[Unit]
Description=FLUX.2 Klein 4B Doodle FastAPI service
Documentation=file:///home/minho/codex_game/app.py
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
WorkingDirectory=/home/minho/codex_game
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONFAULTHANDLER=1
EnvironmentFile=-/home/minho/codex_game/.env
ExecStart=/home/minho/codex_game/.venv/bin/python /home/minho/codex_game/app.py --host 127.0.0.1 --port 7860
Restart=always
RestartSec=10
KillSignal=SIGINT
TimeoutStopSec=45
SuccessExitStatus=0 130
StandardOutput=journal
StandardError=journal
SyslogIdentifier=flux-doodle-api
UMask=0027

[Install]
WantedBy=default.target
